{
  "scripts": {
    "prebuild": "premove build",
    "build": "concurrently -c yellow,magenta node:build:*",
    "build:rollup": "rollup -c",
    "build:sass": "sass --color src:build",
    "prewatch": "premove build",
    "watch": "concurrently -c yellow,magenta node:watch:*",
    "watch:rollup": "node --run build:rollup -- --watch",
    "watch:sass": "node --run build:sass -- --watch",
    "premake-release": "premove build",
    "make-release": "concurrently -c yellow,magenta node:make-release:*",
    "make-release:rollup": "node --run build:rollup -- --no-sourcemap",
    "make-release:sass": "node --run build:sass -- --no-source-map",
    "build-for-amo": "npm run make-release"
  },
  "dependencies": {
    "@guanghechen/rollup-plugin-copy": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "concurrently": "^10.0.6",
    "idb-keyval": "^6.3.0",
    "premove": "^4.0.0",
    "rollup": "^4.64.0",
    "rollup-plugin-svelte": "^7.2.3",
    "sass": "^1.105.1",
    "svelte": "^5.57.1",
    "svelte-webext-storage-adapter": "^3.0.2",
    "svelte-writable-derived": "^3.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4"
  },
  "webExt": {
    "sourceDir": "build/"
  }
}
