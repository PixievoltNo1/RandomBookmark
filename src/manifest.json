{
	"name": "__MSG_extName__",
	"version": "2.2.1",
	"description": "__MSG_extDesc__",
	"author": "Pixievolt No. 1",
	"icons": {
		"48": "icon/48.png",
		"128": "icon/128.png"
	},
	"default_locale": "en",

	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"],
		"type": "module"
	},
	"action": {
		"default_title": "__MSG_extName__",
		"default_popup": "panel/ui.html",
		"default_icon": {
			"32": "icon/32Die.png",
			"40": "icon/40Die.png"
		},
		"default_area": "navbar"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+F"
			}
		},
		"repeat_pick": {
			"suggested_key": {
				"default": "Ctrl+Shift+Period"
			},
			"description": "__MSG_repeatPick__"
		}
	},
	"options_ui": {
		"page": "options/options.html"
	},

	"permissions": ["storage", "bookmarks", "alarms", "unlimitedStorage"],
	"minimum_chrome_version": "121",
	"browser_specific_settings": {
		"gecko": {
			"id": "randombookmark@pikadudeno1.com",
			"strict_min_version": "115.11",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"manifest_version": 3
}